@{
    ViewData["Title"] = "Person";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/style.css"
          asp-append-version="true" />
}

<div class="page-container">
    <main class="main-card">
        <!-- Page Header -->
        <header class="header-section">
            <h1 class="page-title">Person Management</h1>
            <p class="page-subtitle">
                Manage your people easily and efficiently.
            </p>
        </header>

        <!-- Action Buttons -->
        <div class="row g-2 mb-3">
            <div class="col-6 col-md-3">
                <button id="btnAdd" class="btn btn-primary w-100">Add</button>
            </div>

            <div class="col-6 col-md-3">
                <button id="btnEdit" class="btn btn-warning w-100">Edit</button>
            </div>

            <div class="col-6 col-md-3">
                <button id="btnDelete" class="btn btn-danger w-100">Delete</button>
            </div>

            <div class="col-6 col-md-3">
                <button id="btnRefresh" class="btn btn-secondary w-100">Refresh</button>
            </div>
        </div>

        <!-- Person Form -->
        <section class="section-card">
            <div class="section-header">Person Details</div>

            <div class="section-body">
                <form id="personForm">
                    <input type="hidden" id="personId" />

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label for="firstName" class="form-label"> First Name </label>

                            <input type="text"
                                   id="firstName"
                                   name="firstName"
                                   class="form-control"
                                   placeholder="enter your first name"
                                   autocomplete="off" />
                        </div>

                        <div class="col-md-6">
                            <label for="lastName" class="form-label"> Last Name </label>

                            <input type="text"
                                   id="lastName"
                                   name="lastName"
                                   class="form-control"
                                   placeholder="enter your last name"
                                   autocomplete="off" />
                        </div>
                    </div>
                    @Html.AntiForgeryToken()
                </form>
            </div>
        </section>

        <!-- People Table -->
        <section class="section-card">
            <div class="section-header d-flex justify-content-between align-items-center gap-3">
                <span>People List</span>

                <span class="total-count">
                    Total: <span id="totalCount">0</span>
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>
                                <input type="checkbox"
                                       id="selectAll"
                                       class="form-check-input"
                                       aria-label="Select all people" />
                            </th>
                            <th>First Name</th>
                            <th>Last Name</th>
                        </tr>
                    </thead>

                    <tbody id="peopleTableBody">
                        <tr>
                            <td colspan="3" class="empty-state">
                                <div class="fs-5">No data available</div>
                                <div class="empty-state-title">
                                    Your people list is currently empty.
                                </div>
                                <small> Add a person to see them listed here. </small>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</div>
@section Scripts {
    <script src="~/js/Person.js" asp-append-version="true"></script>
}
